{{{
  exports({
    to: app.makePath('app/modules', paramFolder, 'application/dto', kebabName + '.output.dto.ts')
  })
}}}

export class {{ modelName }}OutputDto {
  constructor(
    public readonly id: string,
    // TODO: output properties
    public readonly createdAt?: Date,
    public readonly updatedAt?: Date,
  ) {}
}
