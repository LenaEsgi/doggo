{{#var entity = generators.createEntity(name)}}
{{#var modelName = generators.modelName(entity.name)}}
{{#var className = modelName + 'Repository'}}
{{#var idClassName = modelName + 'Id'}}
{{#var modelReference = string.camelCase(modelName)}}
{{#var resourceFileNameEntity = string(modelName).snakeCase().toString().replaceAll('_', '-')}}
{{#var resourceFileName = resourceFileNameEntity + '.repository.ts'}}
{{#var paramFolder = string(name).camelCase().toString()}}

{{{
  exports({
    to: app.makePath('app/modules', paramFolder, 'domain/contracts', resourceFileName)
  })
}}}
import type {{ modelName }} from '../entities/{{ resourceFileNameEntity }}.entity.js'
import type { {{ idClassName }} } from '../value-objects/{{ resourceFileNameEntity }}-id.js'
import type { PaginatedResult } from '#app/modules/share/DTO/paginated-result.dto'
import type { PaginationDto } from '#app/modules/share/DTO/pagination.dto'

export abstract class {{className}} {
  abstract findById(id: {{ idClassName }}): Promise<{{ modelName }} | null>
  abstract index(options?: PaginationDto): Promise<PaginatedResult<{{ modelName }}>>
  abstract save({{ modelReference }}: {{ modelName }}): Promise<void>
  abstract delete(id: {{ idClassName }}): Promise<void>
}
