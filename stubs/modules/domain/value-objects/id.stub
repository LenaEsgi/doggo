{{#var modelName = generators.modelName(name)}}
{{#var kebabName = string(modelName).snakeCase().toString().replaceAll('_','-')}}
{{#var className = modelName + 'Id'}}
{{#var exceptionName = 'Invalid' + modelName + 'IdError'}}
{{#var paramFolder = string(name).camelCase().toString()}}

{{{
  exports({
    to: app.makePath('app/modules', paramFolder, 'domain/value-objects', kebabName + '-id.ts')
  })
}}}
import { UniqueEntityId } from '#app/modules/share/entities/unique-entity-id'
import { {{ exceptionName }} } from '../exceptions/invalid-{{ kebabName }}-id.error.js'

export class {{ className }} extends UniqueEntityId {
  private constructor(value: string) {
    super(value)
  }

  public static generate(): {{ className }} {
    return new {{ className }}(this.generateUuid())
  }

  public static fromString(value: string): {{ className }} {
    try {
      this.validate(value)
      return new {{ className }}(value)
    } catch {
      throw new {{ exceptionName }}(value)
    }
  }
}
