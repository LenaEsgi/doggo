{{#var entity = generators.createEntity(name)}}
{{#var modelName = generators.modelName(entity.name)}}
{{#var idClassName = modelName + 'Id'}}
{{#var modelReference = string.camelCase(modelName)}}
{{#var kebabName = string(modelName).snakeCase().toString().replaceAll('_', '-')}}
{{#var resourceFileName = kebabName + '.entity.ts'}}
{{#var paramFolder = string(name).camelCase().toString()}}

{{{
  exports({
    to: app.makePath('app/modules', paramFolder, 'domain', resourceFileName)
  })
}}}
import { {{ idClassName }} } from './value-objects/{{ kebabName }}-id.js'

export default class {{ modelName }} {
  private constructor(
    public readonly id: {{ idClassName }},
  ) {}


  public static create(): {{ modelName }} {
    const id = {{ idClassName }}.generate()

    return new {{ modelName }}(id)
  }

  public static rehydrate(id: string): {{ modelName }} {
    return new {{ modelName }}(
      {{ idClassName }}.fromString(id)
    )
  }
}
