{{#var entity = generators.createEntity(name)}}
{{#var modelName = generators.modelName(entity.name)}}
{{#var kebabName = string(modelName).snakeCase().toString().replaceAll('_','-')}}
{{#var className = 'Update' + modelName + 'Controller'}}
{{#var useCaseName = 'Update' + modelName + 'UseCase'}}
{{#var validatorName = 'Update' + modelName + 'Validator'}}
{{#var paramFolder = string(name).camelCase().toString()}}

{{{
  exports({
    to: app.makePath('app/modules', paramFolder, 'infrastructure/http/controllers', 'update-' + kebabName + '.controller.ts')
  })
}}}
import { HttpContext } from '@adonisjs/core/http'
import { inject } from '@adonisjs/core'
import { {{ useCaseName }} } from '../../application/usecases/update-{{ kebabName }}.use-case.js'
import { {{ validatorName }} } from '../validators/update-{{ kebabName }}.validator.js'

@inject()
export default class {{ className }} {
  constructor(private readonly useCase: {{ useCaseName }}) {}

  async handle({ request, params, response }: HttpContext) {
    const payload = await request.validateUsing({{ validatorName }})

    await this.useCase.execute({
      id: params.id,
      ...payload,
    })

    return response.ok({ message: '{{ modelName }} updated successfully' })
  }
}
