{{#var entity = generators.createEntity(name)}}
{{#var modelName = generators.modelName(entity.name)}}
{{#var kebabName = string(modelName).snakeCase().toString().replaceAll('_','-')}}
{{#var className = 'Destroy' + modelName + 'Controller'}}
{{#var useCaseName = 'Destroy' + modelName + 'UseCase'}}
{{#var paramFolder = string(name).camelCase().toString()}}

{{{
  exports({
    to: app.makePath('app/modules', paramFolder, 'infrastructure/http/controllers', 'destroy-' + kebabName + '.controller.ts')
  })
}}}
import { HttpContext } from '@adonisjs/core/http'
import { inject } from '@adonisjs/core'
import { {{ useCaseName }} } from '../../application/usecases/destroy-{{ kebabName }}.use-case.js'

@inject()
export default class {{ className }} {
  constructor(private readonly useCase: {{ useCaseName }}) {}

  async handle({ params, response, logger }: HttpContext) {
    const id = params.id

    logger.info('Starting {{ modelName }} deletion', { id })

    await this.useCase.execute({ id })

    logger.info('{{ modelName }} successfully deleted', { id })

    return response.status(204).json({
      message: '{{ modelName }} deleted successfully'
    })
  }
}
