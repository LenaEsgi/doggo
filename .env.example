TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

FIREBASE_API_KEY=
FIREBASE_SERVICE_ACCOUNT_KEYS=
RESEND_API_KEY=

GCS_BUCKET_NAME=doggo-mission-reports
GCS_SERVICE_ACCOUNT_KEY=
# Local storage emulator (fake-gcs-server) for testing without a real GCP account.
# Leave empty in production to use the real GCS API.
GCS_ENDPOINT=

FRONTEND_URL=http://localhost:5173

# MQTT broker (voir Task 11/12 pour l'auth/TLS)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=doggo-backend
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_CA_PATH=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=doggo
RABBITMQ_PASSWORD=doggo_password
RABBITMQ_VHOST=

# Robot liveness thresholds (optional, defaults shown)
# ROBOT_OFFLINE_THRESHOLD_MS=30000
# ROBOT_RUN_STALE_GRACE_MS=90000
# MISSION_RUN_MAX_DURATION_MS=1800000
